NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jewellery_erp

JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRY=30d

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_SIZE_MB=100

RESEND_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# "Sign in with Google" - see apikey.todo for setup steps
GOOGLE_CLIENT_ID=

CORS_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173

# Optional Cash on Delivery order-value cap - left unset by default
COD_MAX_ORDER_VALUE=

# Auto-seeded login for local development only (never runs in production)
DEV_SEED_PHONE=8888888888
DEV_SEED_PASSWORD=123456
